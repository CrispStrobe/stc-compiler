DEVICE STC12C5A60S2:
  CLOCK 11059200

  PIN led1 = P1.0 OUTPUT ACTIVE LOW
  PIN led2 = P1.1 OUTPUT ACTIVE LOW
  PIN button = P3.2 INPUT ACTIVE LOW

  WHEN started:
    FOREVER:
      toggle led1
      wait 300 ms

  WHEN started:
    FOREVER:
      wait until button
      toggle led2
      REPEAT 4:
        wait 50 ms
      wait until not button
