DEVICE PICO:
  NAME bench
  CLOCK 125000000

  TABLE font = 0x3F, 0x06, 0x5B

  PIN led = GP25 OUTPUT
  PIN dim = GP15 PWM ACTIVE LOW
  PIN buzz = GP16 TONE
  PIN pot = GP26 ANALOG
  PIN btn = GP14 INPUT ACTIVE LOW

  WHEN started:
    print "ready"
    set i to 0
    FOREVER:
      toggle led
      set dim to font[i] percent
      wait pot ms
      change i by 1

  WHEN btn pressed:
    set buzz to 880 hz
    wait 100 ms
    turn off buzz
