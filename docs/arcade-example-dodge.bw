# Dodge! — minimal Arcade example skeleton
#
# A BrickWright dialect program targeting the Arcade sim.
# The player sprite dodges falling enemies; score increments each tick.
# Demonstrates: sprite create, velocity, controller input, overlap, game over.
#
# This is the acceptance fixture for ARCADE-SCOPING.md Stage 1.
# When emit_arcade_ts() exists, this program should compile to Arcade TS
# and run in the vendored sim.

DEVICE ARCADE

# --- sprites -----------------------------------------------------------

SPRITE Player:
  WHEN flag clicked:
    arcade sprite player SHIP
    arcade place player x 80 y 100
    arcade set player stay in screen on

SPRITE Enemy:
  WHEN flag clicked:
    FOREVER:
      arcade sprite enemy DIAMOND
      arcade place enemy x (pick random 10 to 150) y 0
      arcade move enemy vx 0 vy 40
      arcade set enemy destroy on wall on
      WAIT 0.8 secs

# --- controller --------------------------------------------------------

SPRITE Player:
  WHEN flag clicked:
    FOREVER:
      arcade move player vx (controller dx) vy 0

# --- game logic --------------------------------------------------------

SPRITE Game:
  WHEN flag clicked:
    set score to 0
    FOREVER:
      change score by 1
      arcade score add 1
      WAIT 1 secs

  WHEN arcade overlap player enemy:
    arcade game over LOSE

